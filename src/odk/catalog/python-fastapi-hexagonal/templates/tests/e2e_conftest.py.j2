@pytest.fixture(scope="session", autouse=True)
def _create_tables() -> Generator[None, None, None]:
    """Create all tables once for the test session using a dedicated engine and loop.

    Each fixture creates its own engine inside its own event loop to avoid the
    'Task got Future attached to a different loop' error (ERR-7).
    """
    loop = asyncio.new_event_loop()
    try:
        async def _setup() -> None:
            engine = create_async_engine(DATABASE_URL, echo=False)
            try:
                async with engine.begin() as conn:
                    await conn.run_sync(Base.metadata.create_all)
            finally:
                await engine.dispose()

        loop.run_until_complete(_setup())
    finally:
        loop.close()

    yield

    loop = asyncio.new_event_loop()
    try:
        async def _teardown() -> None:
            engine = create_async_engine(DATABASE_URL, echo=False)
            try:
                async with engine.begin() as conn:
                    await conn.run_sync(Base.metadata.drop_all)
            finally:
                await engine.dispose()

        loop.run_until_complete(_teardown())
    finally:
        loop.close()


@pytest.fixture(autouse=True)
def _truncate_tables() -> Generator[None, None, None]:
    """Truncate all tables between E2E tests using a dedicated engine and loop."""
    yield
    if not _TABLES_TO_TRUNCATE:
        return
    tables = ", ".join(_TABLES_TO_TRUNCATE)

    async def _do_truncate() -> None:
        engine = create_async_engine(DATABASE_URL, echo=False)
        try:
            async with engine.connect() as conn:
                await conn.execute(
                    text(f"TRUNCATE {tables} RESTART IDENTITY CASCADE")
                )
                await conn.commit()
        finally:
            await engine.dispose()

    loop = asyncio.new_event_loop()
    try:
        loop.run_until_complete(_do_truncate())
    finally:
        loop.close()


{% if external_adapters %}

class _AsyncStub:
    """No-op async stub for external adapters in E2E tests.

    Returns None for any attribute access and any call (sync or async).
    """

    def __getattr__(self, _name: str) -> "_AsyncStub":
        return self

    def __call__(self, *_args: object, **_kwargs: object) -> "_AsyncStub":
        return self

    def __await__(self):  # noqa: ANN204
        return self._noop().__await__()

    async def _noop(self) -> None:
        return None


{% endif %}
