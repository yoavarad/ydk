# Generated by ydk ci init v{{ version }}. Re-run 'ydk ci init --gitlab --force' to regenerate.
# Every job only calls make (pipeline logic lives in the Makefile); no remote includes, no
# marketplace components. Tools come from the runner image (ci.gitlab.image).
stages:
{% for target in targets %}
  - {{ target }}
{% endfor %}
{% if "scan" in targets %}

variables:
  SCAN_ENABLED: "false"  # the scan job runs only when this is "true"
{% endif %}
{% if image %}

default:
  image: {{ image | tojson }}
{% endif %}
{% for target in targets %}

{{ target }}:
  stage: {{ target }}
  script:
    - make {{ target }}
{% if target == "scan" %}
  rules:
    - if: '$SCAN_ENABLED == "true"'
{% endif %}
{% endfor %}
