# Generated by ydk ci init v{{ version }}. Re-run 'ydk ci init --gitlab --force' to regenerate.
# Make-target jobs only call make (pipeline logic lives in the Makefile); no remote includes, no
# marketplace components. Tools come from the runner image (ci.gitlab.image).
# The exception is ydk-graphify-update: after a push to the default branch it runs
# `graphify update .` (python:3.13 image, pip install graphifyy==0.9.97) and opens one MR from
# chore/graphify-update. It needs a GRAPHIFY_BOT_TOKEN CI/CD variable (project access token,
# write_repository + api; mark it masked and protected); without it the job does not run.
stages:
{% for target in targets %}
  - {{ target }}
{% endfor %}
  - graphify
{% if "scan" in targets %}

variables:
  SCAN_ENABLED: "false"  # the scan job runs only when this is "true"
{% endif %}
{% if image %}

default:
  image: {{ image | tojson }}
{% endif %}
{% for target in targets %}

{{ target }}:
  stage: {{ target }}
  script:
    - make {{ target }}
{% if target == "scan" %}
  rules:
    - if: '$SCAN_ENABLED == "true"'
{% endif %}
{% endfor %}

ydk-graphify-update:
  stage: graphify
  image: "python:3.13"
  resource_group: graphify
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH && $GRAPHIFY_BOT_TOKEN && $CI_COMMIT_TITLE !~ /^chore\(graphify\)/ && $CI_COMMIT_TITLE !~ /^Merge branch .chore\/graphify-update/'
  script:
    - |
      set -e
      if [ ! -d graphify-out ]; then
        echo "No graphify-out directory; nothing to update."
        exit 0
      fi
      pip install graphifyy==0.9.97
      graphify update .
      # Volatile noise is ignored: graphify-out/cache/ (mtime index) and dated scratch dirs.
      list="$(mktemp)"
      git status --porcelain -z --untracked-files=all -- graphify-out ':!graphify-out/cache' | grep -zvE '^.. graphify-out/[0-9]{4}-[0-9]{2}-[0-9]{2}/' | cut -z -c4- > "$list" || true
      if [ ! -s "$list" ]; then
        echo "Graph unchanged; nothing to do."
        exit 0
      fi
      git config user.name "graphify-bot"
      git config user.email "graphify-bot@users.noreply.${CI_SERVER_HOST}"
      git checkout -B chore/graphify-update
      xargs -0 git add -- < "$list"
      git commit -m "chore(graphify): update graph"
      # Token goes in a per-command header, never into the remote URL / .git/config.
      auth="Authorization: Basic $(printf 'graphify-bot:%s' "$GRAPHIFY_BOT_TOKEN" | base64 | tr -d '\n')"
      remote_sha="$(git -c http.extraHeader="$auth" ls-remote --heads origin refs/heads/chore/graphify-update | cut -f1)"
      # Push options open an MR only when no MR is open for the branch (a closed MR with a lingering
      # branch gets a fresh one).
      open_mrs="$(curl -fsS --header "PRIVATE-TOKEN: $GRAPHIFY_BOT_TOKEN" "$CI_API_V4_URL/projects/$CI_PROJECT_ID/merge_requests?state=opened&source_branch=chore/graphify-update" | tr -d ' \n')"
      if [ "$open_mrs" = "[]" ]; then
        git -c http.extraHeader="$auth" push --force-with-lease="chore/graphify-update:$remote_sha" origin chore/graphify-update -o merge_request.create -o merge_request.target="$CI_DEFAULT_BRANCH" -o merge_request.title="chore(graphify): update graph" -o merge_request.remove_source_branch
      else
        git -c http.extraHeader="$auth" push --force-with-lease="chore/graphify-update:$remote_sha" origin chore/graphify-update
      fi
