// Package httpapi wires ydk:route manifests onto a stdlib ServeMux.
package httpapi

import (
	"log/slog"
	"net/http"
	"sync/atomic"
{% if domain_imports %}

{% for imp in domain_imports %}
	"{{ imp }}"
{% endfor %}
{% endif %}
)

// Deps are the collaborators handlers use (one field per ydk:contract).
type Deps struct {
	Logger *slog.Logger
{% for d in deps %}
	{{ d.field }} {{ d.type }}
{% endfor %}
}

// Server holds handler dependencies and readiness state.
type Server struct {
	deps  Deps
	ready atomic.Bool
}

// NewServer returns a ready Server.
func NewServer(deps Deps) *Server {
	if deps.Logger == nil {
		deps.Logger = slog.Default()
	}
	s := &Server{deps: deps}
	s.ready.Store(true)
	return s
}

// SetReady toggles readiness; graceful shutdown sets it to false first.
func (s *Server) SetReady(ready bool) {
	s.ready.Store(ready)
}

// Handler returns the root handler: routes, JSON 404/405 bodies, panic recovery.
func (s *Server) Handler() http.Handler {
	mux := http.NewServeMux()
{% for r in routes %}
	mux.HandleFunc({{ r.pattern_lit }}, s.{{ r.handler }}) // {{ r.id }}
{% endfor %}
	return s.recoverPanics(jsonFallback(mux))
}

// recoverPanics turns a handler panic into a JSON 500 (TODO handlers panic until implemented).
func (s *Server) recoverPanics(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if rec := recover(); rec != nil {
				if rec == http.ErrAbortHandler {
					panic(rec)
				}
				s.deps.Logger.Error("panic recovered", "method", r.Method, "path", r.URL.Path, "panic", rec)
				writeError(w, http.StatusInternalServerError, {{ msg_500 }})
			}
		}()
		next.ServeHTTP(w, r)
	})
}

// jsonFallback replaces the ServeMux's plain-text 404/405 bodies with JSON, keeping Allow.
func jsonFallback(mux *http.ServeMux) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if _, pattern := mux.Handler(r); pattern != "" {
			mux.ServeHTTP(w, r)
			return
		}
		capture := &statusCapture{header: http.Header{}}
		mux.ServeHTTP(capture, r)
		switch capture.status {
		case http.StatusNotFound:
			writeError(w, http.StatusNotFound, {{ msg_404 }})
		case http.StatusMethodNotAllowed:
			w.Header().Set("Allow", capture.header.Get("Allow"))
			writeError(w, http.StatusMethodNotAllowed, renderMessage({{ msg_405 }}, "${method}", r.Method))
		default:
			mux.ServeHTTP(w, r)
		}
	})
}

// statusCapture records the status and headers the mux would send, discarding the body.
type statusCapture struct {
	header http.Header
	status int
}

func (c *statusCapture) Header() http.Header { return c.header }

func (c *statusCapture) Write(b []byte) (int, error) {
	if c.status == 0 {
		c.status = http.StatusOK
	}
	return len(b), nil
}

func (c *statusCapture) WriteHeader(status int) {
	if c.status == 0 {
		c.status = status
	}
}
