#!/bin/sh
# Generated by YDK go-http-service (env phase): make build
set -eu
cd "$(dirname "$0")/.."
. scripts/env.sh

require go
mkdir -p bin
CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=$VERSION" -o "bin/$APP" "$MAIN_PKG"
echo "build: bin/$APP ($VERSION)"
if [ -f Dockerfile ]; then
  if command -v docker >/dev/null 2>&1; then
    docker build -t "$IMAGE" .
  else
    echo "build: docker not found, skipping image $IMAGE"
  fi
else
  echo "build: no Dockerfile, skipping image"
fi
