#!/bin/sh
# Generated by YDK go-http-service (env phase): make publish
set -eu
cd "$(dirname "$0")/.."
. scripts/env.sh

: "${REGISTRY:?REGISTRY must be set, e.g. ghcr.io/<owner>}"
require docker
docker tag "$IMAGE" "$REGISTRY/$IMAGE_REPO:$VERSION"
docker push "$REGISTRY/$IMAGE_REPO:$VERSION"
if [ -d "$CHART_DIR" ]; then
  require helm
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  helm package "$CHART_DIR" --version "$VERSION" --app-version "$VERSION" --destination "$tmp"
  for pkg in "$tmp"/*.tgz; do
    helm push "$pkg" "oci://$REGISTRY/charts"
  done
fi
