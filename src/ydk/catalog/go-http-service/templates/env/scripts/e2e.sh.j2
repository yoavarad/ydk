#!/bin/sh
# Generated by YDK go-http-service (env phase): make e2e
set -eu
cd "$(dirname "$0")/.."
. scripts/env.sh

require kind docker kubectl helm curl
# Tear down only a cluster this run created (and not with KEEP_ENV=1).
created=0
if ! kind get clusters 2>/dev/null | grep -qx "$CLUSTER"; then
  created=1
fi
if [ "$created" = 1 ] && [ "${KEEP_ENV:-0}" != 1 ]; then
  trap 'sh scripts/env-down.sh' EXIT
fi
sh scripts/env-up.sh
sh scripts/build.sh
docker image inspect "$IMAGE" >/dev/null 2>&1 || die "image $IMAGE was not built (Dockerfile missing?)"
kind load docker-image "$IMAGE" --name "$CLUSTER"
sh scripts/deploy.sh
for t in test/e2e/*.sh; do
  case "$(basename "$t")" in
    lib.sh) continue ;;
  esac
  [ -f "$t" ] || continue
  echo "e2e: $t"
  sh "$t"
done
echo "e2e: ok"
