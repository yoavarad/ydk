# Sourced by scripts/*.sh from the project root. Every value can be overridden from the environment.
: "${APP:={{ app }}}"
: "${CLUSTER:={{ env.cluster }}}"
: "${NAMESPACE:={{ env.namespace }}}"
{% if kafka %}
: "${KAFKA_CLUSTER:={{ env.kafka_cluster }}}"
: "${STRIMZI_VERSION:={{ env.strimzi_version }}}"
{% endif %}
: "${HOST_PORT:={{ env.host_port }}}"
: "${IMAGE_REPO:=$APP}"
: "${CHART_DIR:=charts/$APP}"
: "${MAIN_PKG:=./cmd/$APP}"

die() {
  echo "error: $*" >&2
  exit 1
}

# require <cmd>...: fail clearly when a command is missing from PATH.
require() {
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || die "'$cmd' is required but was not found on PATH"
  done
}

# VERSION: tag vX.Y.Z -> X.Y.Z; otherwise <last tag or 0.0.0>-dev.<shortsha>; no git -> 0.0.0-dev.local.
if [ -z "${VERSION:-}" ]; then
  if command -v git >/dev/null 2>&1 && git rev-parse --verify -q HEAD >/dev/null 2>&1; then
    tag=$(git describe --tags --exact-match --match 'v[0-9]*' 2>/dev/null || true)
    case "$tag" in
      v[0-9]*.[0-9]*.[0-9]*) VERSION=${tag#v} ;;
      *)
        last=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 2>/dev/null || echo v0.0.0)
        VERSION="${last#v}-dev.$(git rev-parse --short HEAD)"
        ;;
    esac
  else
    VERSION=0.0.0-dev.local
  fi
fi
: "${IMAGE:=$IMAGE_REPO:$VERSION}"
export APP MAIN_PKG CLUSTER NAMESPACE HOST_PORT IMAGE_REPO CHART_DIR VERSION IMAGE{{ " KAFKA_CLUSTER STRIMZI_VERSION" if kafka else "" }}
