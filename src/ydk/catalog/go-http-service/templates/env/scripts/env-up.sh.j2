#!/bin/sh
# Generated by YDK go-http-service (env phase): make env-up
set -eu
cd "$(dirname "$0")/.."
. scripts/env.sh

require kind kubectl helm
if kind get clusters 2>/dev/null | grep -qx "$CLUSTER"; then
  echo "env-up: kind cluster $CLUSTER already exists"
else
  kind create cluster --name "$CLUSTER" --config deploy/local/kind-config.yaml
fi
kubectl config use-context "kind-$CLUSTER"

: "${INGRESS_NGINX_MANIFEST:=https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.12.1/deploy/static/provider/kind/deploy.yaml}"
kubectl apply -f "$INGRESS_NGINX_MANIFEST"
kubectl -n ingress-nginx rollout status deployment/ingress-nginx-controller --timeout=300s

kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -
{% if kafka %}

helm upgrade --install strimzi-kafka-operator oci://quay.io/strimzi-helm/strimzi-kafka-operator \
  --version "$STRIMZI_VERSION" --namespace "$NAMESPACE" --create-namespace --wait
kubectl apply -f deploy/local/kafka.yaml
kubectl wait "kafka/$KAFKA_CLUSTER" -n "$NAMESPACE" --for=condition=Ready --timeout=600s
{% if env.topics %}
kubectl apply -f deploy/local/kafka-topics.yaml
{% endif %}
{% if env.users %}
kubectl apply -f deploy/local/kafka-users.yaml
{% endif %}
{% for u in env.users %}

kubectl wait kafkauser/{{ u }} -n "$NAMESPACE" --for=condition=Ready --timeout=300s
password=$(kubectl get secret {{ u }} -n "$NAMESPACE" -o go-template='{% raw %}{{.data.password | base64decode}}{% endraw %}')
kubectl create secret generic {{ u }}-credentials -n "$NAMESPACE" \
  --from-literal=username={{ u }} --from-literal=password="$password" \
  --dry-run=client -o yaml | kubectl apply -f -
{% endfor %}
{% endif %}
echo "env-up: ok"
