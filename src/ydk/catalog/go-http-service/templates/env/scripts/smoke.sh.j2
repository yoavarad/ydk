#!/bin/sh
# Generated by YDK go-http-service (env phase): make smoke
set -eu
cd "$(dirname "$0")/.."
. scripts/env.sh

require curl
. test/e2e/lib.sh
{% for r in env.releases %}
wait_ready "${{ r.var }}"
{% endfor %}
# App-specific smoke checks (e.g. one functional round trip) belong in test/smoke/*.sh;
# they are run here after every release is ready and can use the helpers in test/e2e/lib.sh.
for t in test/smoke/*.sh; do
  [ -f "$t" ] || continue
  echo "smoke: $t"
  sh "$t"
done
echo "smoke: ok"
