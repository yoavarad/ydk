#!/bin/sh
# Generated by YDK go-http-service (env phase): make lint
set -eu
cd "$(dirname "$0")/.."
. scripts/env.sh

require go gofmt
unformatted=$(find . -name '*.go' ! -path './vendor/*' ! -path './.*' -exec gofmt -l {} +)
if [ -n "$unformatted" ]; then
  echo "gofmt -l reports unformatted files:" >&2
  echo "$unformatted" >&2
  exit 1
fi
go vet ./...
if [ -d vendor ]; then
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  go mod vendor -o "$tmp/vendor"
  diff -r vendor "$tmp/vendor" || die "vendor/ is out of date: run go mod vendor"
fi
if [ -d "$CHART_DIR" ]; then
  if command -v helm >/dev/null 2>&1; then
    helm lint --strict "$CHART_DIR"
  else
    echo "lint: helm not found, skipping chart lint"
  fi
fi
echo "lint: ok"
