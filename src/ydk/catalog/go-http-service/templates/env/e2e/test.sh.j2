#!/bin/sh
# Generated by YDK go-http-service from ydk:test:{{ test.tail }}.
# TDD skeleton: every case fails until implemented.
set -eu
. "$(dirname "$0")/lib.sh"
{% for c in test.cases %}

# ydk:test:{{ test.tail }} case={{ c.name }}
# {{ c.description }}
# given: {{ c.given }}
# when: {{ c.when }}
# then: {{ c.then }}
{{ c.fn }}() {
  echo 'not implemented: {{ c.name | replace("'", "") }}'
  return 1
}
{% endfor %}

failed=0
for c in{% for c in test.cases %} {{ c.fn }}{% endfor %}; do
  # set -e must stay active inside each case, so the subshell is not an if/&&/|| operand.
  set +e
  ( set -e; "$c" )
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    echo "ok: $c"
  else
    echo "FAIL: $c"
    failed=1
  fi
done
exit "$failed"
