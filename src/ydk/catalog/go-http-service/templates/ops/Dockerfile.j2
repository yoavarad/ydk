# Container image for [[ app ]], generated by the go-http-service ignition pack (phase ops).
# The build stage is offline: modules come from vendor/ (run `go mod vendor` before building),
# GOPROXY=off, and the go build step runs with --network=none (BuildKit or buildah).
# The runtime runs as a numeric non-root USER with group-0 ownership, so an arbitrary UID
# in group 0 (e.g. OpenShift restricted-v2) can run it on a read-only root filesystem.
# Override the images with --build-arg, or with the builder_image / runtime_image init answers.
ARG BUILDER_IMAGE=[[ builder_image ]]
ARG RUNTIME_IMAGE=[[ runtime_image ]]

FROM ${BUILDER_IMAGE} AS build
ARG VERSION=dev
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=vendor GOPROXY=off GOTOOLCHAIN=local
COPY . .
RUN --network=none go build -mod=vendor -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/[[ app ]] ./cmd/[[ app ]] \
    && chmod 0555 /out/[[ app ]]

FROM ${RUNTIME_IMAGE}
[% if runtime_image == "scratch" %]
# CA roots go to a private path (never /etc/ssl/certs, which a swapped RUNTIME_IMAGE owns).
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/ydk/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/ydk/ca-certificates.crt
[% endif %]
COPY --from=build --chown=1001:0 /out/[[ app ]] /usr/local/bin/[[ app ]]
USER 1001
EXPOSE [[ port ]]
ENTRYPOINT ["/usr/local/bin/[[ app ]]"]
