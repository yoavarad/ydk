from __future__ import annotations

from collections.abc import AsyncGenerator
from contextlib import asynccontextmanager

{% if error_mappings %}
from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
{% else %}
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
{% endif %}

from app.api.errors import register_error_handlers
from app.api.routes import api_router
from app.config import get_settings
{% for mapping in error_mappings %}
from {{ mapping.module }} import {{ mapping.exception }}
{% endfor %}


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncGenerator[None, None]:
    # YDK-TODO: start scheduler, wire event emitter, run seed data
    yield
    # YDK-TODO: stop scheduler, flush event buffers


def create_app() -> FastAPI:
    settings = get_settings()

    app = FastAPI(
        title="{{ app.title }}",
        version="{{ app.version }}",
        description="{{ app.description | default('') }}",
        docs_url="/docs",
        redoc_url="/redoc",
        lifespan=lifespan,
    )

    app.add_middleware(
        CORSMiddleware,
        allow_origins={{ cors.allow_origins | tojson }},
        allow_credentials={{ cors.allow_credentials | tojson | capitalize }},
        allow_methods={{ cors.allow_methods | tojson }},
        allow_headers={{ cors.allow_headers | tojson }},
    )

    app.include_router(api_router, prefix="/api")

    register_error_handlers(app)
{% for mapping in error_mappings %}

    @app.exception_handler({{ mapping.exception }})
    async def handle_{{ mapping.exception | lower }}(_request: Request, exc: {{ mapping.exception }}) -> JSONResponse:
        return JSONResponse(
            status_code={{ mapping.status_code }},
            content={"error": "{{ mapping.code }}", "message": str(exc)},
        )
{% endfor %}

    @app.get("/health", tags=["health"])
    def health_check() -> dict:
        return {"status": "ok", "version": settings.app_version}

    return app


app = create_app()
