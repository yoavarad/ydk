# NOTE: Do NOT add 'from __future__ import annotations' — FastAPI requires runtime type evaluation.

{% if has_try_routes %}
from fastapi import APIRouter, HTTPException
{% else %}
from fastapi import APIRouter
{% endif %}

{% for svc_import in service_imports %}
{{ svc_import }}
{% endfor %}
{% if has_schema_usage %}
from app.api.schemas import {{ schema_domain }} as schemas
{% endif %}
{% for extra_imp in extra_schema_imports %}
{{ extra_imp }}
{% endfor %}

router = APIRouter(prefix="/{{ tag }}", tags=["{{ tag }}"])

{% for route in routes %}
@router.{{ route.method | lower }}('{{ route.path }}', status_code={{ route.status_code }}{% if route.response_model %}, response_model={{ route.response_model }}{% endif %})
async def {{ route.func_name }}({{ route.param_str }}):
    {% if route.is_stub %}
    # YDK-TODO: wire service call for {{ route.method | upper }} /api/{{ tag }}{{ route.path }}
    raise NotImplementedError
    {% elif route.is_delete %}
    {{ route.service_call }}
    return None
    {% elif route.needs_try %}
    try:
        return {{ route.service_call }}
    except Exception:
        raise HTTPException(status_code=404, detail="Not found")
    {% else %}
    return {{ route.service_call }}
    {% endif %}

{% endfor %}
