from app.core.ports.{{ snake_name }}_repository import {{ name }}RepositoryPort


def test_postgres_{{ snake_name }}_repo_satisfies_port() -> None:
    """Structural subtype check — runtime_checkable Protocol."""
    mock_session = MagicMock()
    repo = Postgres{{ name }}Repository(mock_session)
    assert isinstance(repo, {{ name }}RepositoryPort), (
        "Postgres{{ name }}Repository does not satisfy {{ name }}RepositoryPort. "
        "Check that all port methods are implemented."
