def test_postgres_{{ snake_name }}_repo_has_all_methods() -> None:
    """All required port methods must be present and callable."""
    mock_session = MagicMock()
    repo = Postgres{{ name }}Repository(mock_session)
    for method_name in ["get", "list", "create", "update", "delete", "exists"]:
